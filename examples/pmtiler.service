# Example systemd unit -- install to /etc/systemd/system/pmtiler.service,
# then: systemctl daemon-reload && systemctl enable --now pmtiler
#
# Assumes a dedicated user and a checkout at /opt/pmtiler pinned to a tag
# (no build step):
#   useradd --system --home /var/lib/pmtiler pmtiler
#   install -d -o pmtiler /var/lib/pmtiler/spool
#
# Upgrade: fetch, check out the new tag, systemctl restart pmtiler --
# crash recovery re-queues any job the restart interrupted.

[Unit]
Description=overpass-pmtiler: Overpass query -> PMTiles archive
After=network.target

[Service]
Type=simple
User=pmtiler
WorkingDirectory=/opt/pmtiler
ExecStart=/usr/bin/python3 /opt/pmtiler/pmtiler.py
Restart=on-failure
RestartSec=5

Environment=PMTILER_SPOOL=/var/lib/pmtiler/spool
Environment=PMTILER_OVERPASS=http://localhost/api/interpreter
# The bake already runs tippecanoe under nice (PMTILER_NICE, default 10);
# fetch/convert stay at normal priority on purpose -- see README.

# Sandbox: the service only ever writes inside its spool (tippecanoe's
# TMPDIR is pointed into the job dir by the service itself). This also
# hard-limits the blast radius of any path-handling bug.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pmtiler/spool
PrivateTmp=true

[Install]
WantedBy=multi-user.target
